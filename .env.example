# ShopQ Environment Configuration
# Copy this file to .env and update values for your XAMPP setup

APP_NAME=ShopQ
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/shopq/public

# Database (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopq_database
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=7200
SESSION_NAME=shopq_session

# Security
CSRF_TOKEN_NAME=_csrf_token

# Upload limits (bytes)
MAX_UPLOAD_SIZE=5242880

# Mail (future)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@shopq.local

# Payment (future Razorpay)
RAZORPAY_KEY=
RAZORPAY_SECRET=
PAYMENT_GATEWAY=dummy
